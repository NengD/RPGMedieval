; Fichier de projet Godot - prototype de combat médiéval
config_version=5

[application]

config/name="RPG Médiéval - Prototype de combat"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/input_setup.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="monde"
3d_physics/layer_2="joueur"
3d_physics/layer_3="ennemis"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
